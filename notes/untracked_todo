/* playlist_cache.h */
namespace PlaylistCache {
	struct Node {
		Playlist playlist;
		bool is_tracked;
		bool was_changed;
		Node* next;
	};
	
	struct Head {
		Node* ptr;
		Platform platform;
	};

	template <bool is_const>
	struct Iterator;
	using const_iterator = Iterator<false>;
	using iterator = Iterator<true>;

	Node* load();
	void update(Node*);
	void save(Node*);

	Playlist get_playlist(Platform, id);
	fill_short_ids(std::vector<Playlist>&);
	sort(Node*);
}
