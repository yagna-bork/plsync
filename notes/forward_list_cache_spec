class PlaylistCache {
	struct Node {
		Playlist playlist
		Node* next
		bool was_changed

		Node(next)
		Node(playlist, next, was_changed)
	}
	
	Node* head
	set<string> delete_ids
	path cache_dir
}

get_playlist(proto::Playlist)
get_proto_playlist(Playlist)

constructor() {
	if HEAD not exists make it // dropping .pb extension

	proto::Node proto_node = Parse(HEAD) 
	Node* node = make from proto_node
	while (proto_node.next) {
		proto_node = Parse(proto_node.next)
		node->next = make from proto_node
		node = node->next
	}
}

destructor() {
	// persist changed or newly added playlists
	curr = cbefore_begin(), next = begin()
	for (; curr != end; ++curr, ++next) {
		if (!curr.node->was_changed) {
			cont
		}
		proto_node.playlist = get_proto_playlist(*curr)
		proto_node.next = (next != end) ? next->id : ""
		file(curr->id)
		proto_node.Serialize(file)
	}
	
	// persist deleted playlists
	for (id: delete_ids) {
		delete cache_dir / id
	}
	
	// delete all nodes
	node = head
	while (node) {
		tmp = node
		node = node->next
		delete tmp
	}
}

template <bool is_const>
struct Iterator {
	Node* node
	Iterator(): node(nullptr) {}
	Iterator(Node* node): node(node) {}
	operator*() { 
		if (this == head) throw;
		node->was_changed = !is_const
		return node->playlist
	}
	operator->() {
		if (this == head) throw;
		node->was_changed = !is_const
		return &node->playlist
	}
	operator++() {
		node = node->next()
		return this
	}
	operator++(int) {
		Iterator<is_const> copy = this
		node = node->next
		return copy
	}
	operator==(rhs) { return node == rhs.node }
	operator!=(rhs) { return !(this == rhs) }
}

