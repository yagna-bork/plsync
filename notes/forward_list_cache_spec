	Iterator(const Iterator<false> &&other): node(std::move(other.node))
}
Iterator<true>(const Iterator<false> &)
Iterator<true>(Iterator<false> &&)

before_begin() { return Iterator(head) }
begin() { return ++before_begin() }
end() { return Iterator() }

iterator insert_after(const_iterator pos, Playlist p) {
	delete_ids.erase(p.id); // in case previously deleted playlist re-added
	auto next = pos;
	++next;
	pos.node->next = new Node(p, next.node, was_changed=true);
	pos.node->was_changed = true;
	return iterator(pos.node->next);
}

iterator erase_after(const_iterator pos) {
	auto next = pos;
	++next;
	pos.node->next = next.node->next;
	pos.node->was_changed = true;
	next.node->next = nullptr;
	delete_ids.insert(next->id);
	return iterator(pos.node->next);
}

sort() {
	vector<pair<string, Node*>> title_to_node;
	it = cbegin();
	while (it != end()) {
		title_to_node.emplace_back(beg->title, beg.node);
	}
	sort(title_to_node);

	it = cbefore_begin();
	for (&title_node: title_to_node) {
		node = title_node.second;
		it.node->was_changed = it.node->next != node;
		it.node->next = node;
		++it;
	}
	it.node->was_changed = it.node->next != nullptr;
	it.node->next = nullptr; // explain why
}

