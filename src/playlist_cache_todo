vector playlists = get_playlists();
if (is_sorted) return playlists;

std::sort(playlists, []() { cmp(id) });
it node = before_beg();
for (playlist: playlists) {
	node->next = playlist.id;
	node++;
}
node->clear_last(); // comment to explain
is_sorted = true();
return playlists;
