PlaylistCacheHead
-----------------
Parse PlaylistCacheHead once in constructor
Store all attributes of PlaylistCacheHead as attributes of PlaylistCache
Serialise PlaylistCacheHead once in destructor

update() pseudocode
-----------------
prev = before_begin()
curr = begin()
while (curr != end()) {
	if (etag same) {
		 prev=std::move(curr); curr++; // move assignment
	} else if (id found) {
		curr->attr = new_val; // operator->
		is_sorted = false; // new class attribute 
		prev=std::move(curr); curr++;
	} else {
		prev->next = curr->id;
		curr++;
		erase_after(prev); // new forward_list method
		is_sorted = false;
	}
}

curr = prev;
for (is_new) {
	insert_after(curr);
	curr++;
}

